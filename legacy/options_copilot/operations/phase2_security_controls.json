  "mitigation_commands": [
    {
      "description": "Read-only API projections force supporting-only authority and omit order primitives.",
      "id": "api_supporting_only",
      "kind": "pytest",
      "targets": [
        "tests/options_copilot/test_api_frontend.py::test_frontend_fetches_only_local_read_models_and_has_no_direct_order_primitive",
        "tests/options_copilot/test_api_frontend.py::test_news_api_preserves_conditional_option_contract_and_forces_supporting_only"
      ]
    },
    {
      "arguments": [
        "--root",
        "options_copilot",
        "--json"
      ],
      "description": "Static call-graph audit rejects broker submit, transmit, and order-placement authority.",
      "id": "authority_audit",
      "kind": "static",
      "module": "options_copilot.operations.authority_audit"
    },
    {
      "description": "Authority-audit tests cover direct, aliased, protocol, inherited, and transitive write surfaces.",
      "id": "authority_audit_tests",
      "kind": "pytest",
      "targets": [
        "tests/options_copilot/test_authority_audit.py::test_direct_import_alias_attribute_call_and_constant_getattr_fail",
        "tests/options_copilot/test_authority_audit.py::test_protocol_surface_and_inherited_unsafe_method_fail"
      ]
    },
    {
      "description": "Evidence tests reject secret-like payloads and canonical hash tampering.",
      "id": "evidence_integrity",
      "kind": "pytest",
      "targets": [
        "tests/options_copilot/test_evidence_store.py::test_secret_like_payload_and_hash_tampering_fail_closed"
      ]
    },
    {
      "description": "Provider transports enforce exact HTTPS destinations, redirect denial, bounded JSON, and sanitized failures.",
      "id": "provider_transport",
      "kind": "pytest",
      "targets": [
        "tests/options_copilot/test_event_providers.py::test_alpha_vantage_transport_failure_does_not_chain_token_bearing_url",
        "tests/options_copilot/test_nasdaq_earnings_provider.py::test_https_transport_rejects_redirects_oversize_and_duplicate_json_keys",
        "tests/options_copilot/test_official_calendar_provider.py::test_non_https_source_is_rejected_at_configuration_boundary",
        "tests/options_copilot/test_sec_current_provider.py::test_https_transport_rejects_redirect_content_type_and_oversize"
      ]
    },
    {
      "description": "Reaction evidence preserves official conflicts, chronology, no-trade degradation, and supporting-only authority.",
      "id": "reaction_integrity",
      "kind": "pytest",
      "targets": [
        "tests/options_copilot/test_news_reaction.py::test_conflicting_same_vintage_official_releases_fail_closed",
        "tests/options_copilot/test_news_reaction.py::test_supporting_payloads_cannot_claim_approval_instruction_or_order_authority"
      ]
    },
    {
      "description": "Security-gate tests pin the exact tagged ASVS inventory and fail structural or residual-risk drift.",
      "id": "security_gate_contract",
      "kind": "pytest",
      "targets": [
        "tests/options_copilot/test_phase2_security_gate.py::test_phase2_security_register_pins_exact_asvs_500_inventory"
      ]
    },
    {
      "description": "Workspace tests reject plan/manifest self-authorization and immutable plan-hash substitution.",
      "id": "workspace_authority",
      "kind": "pytest",
      "targets": [
        "tests/options_copilot/test_workspace_guard.py::test_phase_02_manifest_rejects_wrong_immutable_plan_hash",
        "tests/options_copilot/test_workspace_guard.py::test_phase_02_plan_and_manifest_coedit_cannot_self_authorize_source"
      ]
    }
  ],
